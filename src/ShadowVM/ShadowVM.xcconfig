ARCHS = arm64
LIBRARY_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/../3rd_party
SWIFT_INCLUDE_PATHS = $(inherited) $(PROJECT_DIR)/../3rd_party
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CODE_SIGN_ENTITLEMENTS = $(PRODUCT_NAME)/$(PRODUCT_NAME).entitlements
COMBINE_HIDPI_IMAGES = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = $(PRODUCT_NAME)/Info.plist
INFOPLIST_KEY_NSPrincipalClass = NSApplication
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
PRODUCT_BUNDLE_IDENTIFIER = com.saagarjha.$(PRODUCT_NAME)
PRODUCT_NAME = $(TARGET_NAME)
SWIFT_EMIT_LOC_STRINGS = YES
